[Version]
Signature="$CHICAGO$"
Class=MEDIA
Provider=%YAMAHA%
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer=01/24/2020,1.0.0.0
CatalogFile=syncroom.cat

[SourceDisksNames]
222="DUETTO Driver Disk","",222

[SourceDisksFiles]
syncroom.sys=222

;;This syntax is only recognized on Windows XP and above- it is needed to install 64-bit drivers on
;;Windows Server 2003 Service Pack 1 and above.

[Manufacturer]
%MfgName%=YamahaCorp,NTAMD64

;;  For Windows Server 2003 Service Pack 1 and above, a 64-bit OS will not install a driver
;;  unless the Manufacturer and Models Sections explicitly show it is a driver for that platform
;;  But the individual model section decorations (or lack thereof) work as they always have.
;;  All of the model sections referred to are undecorated or NT-decorated, hence work on all platforms

[YamahaCorp]
%DUETTO_Simple.DeviceDesc%=DUETTO_Simple,*SYNCROOMSimple

;; This section enables installing on x64 systems

[YamahaCorp.NTAMD64]
%DUETTO_Simple.DeviceDesc%=DUETTO_Simple,*SYNCROOMSimple

[DestinationDirs]
DUETTO_Simple.CopyList=10,system32\drivers

;======================================================
; DUETTO_SIMPLE
;======================================================
[DUETTO_Simple]
AlsoInstall=ks.registration(ks.inf),wdmaudio.registration(wdmaudio.inf)
CopyFiles=DUETTO_Simple.CopyList
AddReg=DUETTO_Simple.AddReg

[DUETTO_Simple.CopyList]
syncroom.sys

[DUETTO_Simple.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,DUETTO.I.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,DUETTO.I.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,DUETTO.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,DUETTO.I.Topo

[DUETTO_Simple.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,syncroom.sys

HKR,Drivers,SubClasses,,"wave"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%DUETTO_Simple.DeviceDesc%

HKLM,%MediaCategories%\%Simple.NameGuid%,Name,,%Simple.Name%

;======================================================
; COMMON
;======================================================
[DUETTO.I.Wave]
AddReg=DUETTO.I.Wave.AddReg
[DUETTO.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DUETTO.Wave.szPname%

[DUETTO.I.Topo]
AddReg=DUETTO.I.Topo.AddReg
[DUETTO.I.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DUETTO.Topo.szPname%
HKR,"EP\\0",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_LINE_CONNECTOR%
HKR,"EP\\0",%PKEY_AudioDevice_NeverSetAsDefaultEndpoint%,0x00010001,0x00000305

;======================================================
; DUETTO_SIMPLE
;======================================================
[DUETTO_Simple.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DUETTO_Simple.CopyList
AddReg=DUETTO_Simple.AddReg

[DUETTO_Simple.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,DUETTO.I.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,DUETTO.I.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,DUETTO.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,DUETTO.I.Topo

[DUETTO_Simple.NT.Services]
AddService=duetto_simple,0x00000002,duetto_Simple_Service_Inst

[duetto_Simple_Service_Inst]
DisplayName=%duetto_simple.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%10%\system32\drivers\syncroom.sys

;======================================================
; COMMON
;======================================================
[Strings]
YAMAHA="Yamaha Corporation"
MfgName="Yamaha"
DUETTO_Simple.DeviceDesc="Yamaha SYNCROOM Driver (WDM)"

DUETTO.Wave.szPname="DUETTO Wave"
DUETTO.Topo.szPname="DUETTO Topology"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"

KSNAME_Wave="Wave"
KSNAME_Topology="Topology"

duetto_simple.SvcDesc="Yamaha SYNCROOM Driver"

MediaCategories="SYSTEM\CurrentControlSet\Control\MediaCategories"

Simple.NameGuid="{84753B18-4C37-4A40-A4D1-9EA2B65B6749}"
Simple.Name="Yamaha SYNCROOM Driver"

KSNODETYPE_LINE_CONNECTOR="{DFF21FE3-F70F-11D0-B917-00A0C9223196}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioDevice_NeverSetAsDefaultEndpoint="{F3E80BEF-1723-4FF2-BCC4-7F83DC5E46D4},3"
