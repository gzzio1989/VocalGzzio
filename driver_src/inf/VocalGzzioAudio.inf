; ============================================================================
; VocalGzzioAudio.inf
; 100%自社実装 Windows 10 / 11 (x64 & ARM64) Universal Audio Driver INF
; Microsoft Hardware Dashboard (Attestation Signing) / InfVerif Universal 準拠
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = VocalGzzioAudio.cat
DriverVer   = 10/30/2026,1.0.0.0
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
VocalGzzioAudio.sys = 1

[DestinationDirs]
DefaultDestDir           = 13
VocalGzzioAudio.CopyList = 13

[Manufacturer]
%MfgName% = GzzioModels,NTamd64.10.0...17763,NTarm64.10.0...17763

[GzzioModels.NTamd64.10.0...17763]
%VocalGzzioAudio.DeviceDesc% = VocalGzzioAudio_Install, ROOT\VocalGzzioAudio

[GzzioModels.NTarm64.10.0...17763]
%VocalGzzioAudio.DeviceDesc% = VocalGzzioAudio_Install, ROOT\VocalGzzioAudio

; ============================================================================
; Install Sections (Windows 10 1809+ / Windows 11 Universal)
; ============================================================================
[VocalGzzioAudio_Install.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = VocalGzzioAudio.CopyList
AddReg    = VocalGzzioAudio.AddReg

[VocalGzzioAudio.CopyList]
VocalGzzioAudio.sys

[VocalGzzioAudio.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,VocalGzzioAudio.sys
HKR,Drivers,SubClasses,,"wave"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%VocalGzzioAudio.DeviceDesc%

[VocalGzzioAudio_Install.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Wave%,     VocalGzzioAudio.I.Wave
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_Wave%,     VocalGzzioAudio.I.Wave
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_Wave%,     VocalGzzioAudio.I.Wave
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Wave%,     VocalGzzioAudio.I.Wave
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Topology%, VocalGzzioAudio.I.Topo
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_Topology%, VocalGzzioAudio.I.Topo

[VocalGzzioAudio.I.Wave]
AddReg = VocalGzzioAudio.I.Wave.AddReg

[VocalGzzioAudio.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VocalGzzioAudio.Wave.szPname%

[VocalGzzioAudio.I.Topo]
AddReg = VocalGzzioAudio.I.Topo.AddReg

[VocalGzzioAudio.I.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VocalGzzioAudio.Topo.szPname%
; 仮想ライン入出力として関連付け、インストール時にユーザーの既定スピーカー・マイクを奪わないよう設定
HKR,"EP\0",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_LINE_CONNECTOR%
HKR,"EP\0",%PKEY_AudioDevice_NeverSetAsDefaultEndpoint%,0x00010001,0x00000305
HKR,"EP\1",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_LINE_CONNECTOR%
HKR,"EP\1",%PKEY_AudioDevice_NeverSetAsDefaultEndpoint%,0x00010001,0x00000305

[VocalGzzioAudio_Install.NT.Services]
AddService = VocalGzzioAudio, 0x00000002, VocalGzzioAudio_Service_Inst

[VocalGzzioAudio_Service_Inst]
DisplayName   = %VocalGzzioAudio.SvcDesc%
ServiceType   = 1                  ; SERVICE_KERNEL_DRIVER
StartType     = 3                  ; SERVICE_DEMAND_START
ErrorControl  = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\VocalGzzioAudio.sys

; ============================================================================
; Strings
; ============================================================================
[Strings]
ProviderName                   = "Gzzio"
MfgName                        = "Gzzio"
DiskName                       = "VocalGzzio Virtual Audio Driver Installation Media"
VocalGzzioAudio.DeviceDesc     = "VocalGzzio Driver (WDM)"
VocalGzzioAudio.SvcDesc        = "VocalGzzio Virtual Audio Driver (WaveRT)"
VocalGzzioAudio.Wave.szPname   = "VocalGzzio WaveRT"
VocalGzzioAudio.Topo.szPname   = "VocalGzzio Topology"

Proxy.CLSID                    = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO               = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER              = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE             = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME            = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY            = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNAME_Wave                    = "Wave"
KSNAME_Topology                = "Topology"

KSNODETYPE_LINE_CONNECTOR      = "{DFF21FE3-F70F-11D0-B917-00A0C9223196}"
PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioDevice_NeverSetAsDefaultEndpoint = "{F3E80BEF-1723-4FF2-BCC4-7F83DC5E46D4},3"
